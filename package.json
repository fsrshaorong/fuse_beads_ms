{
    "name": "fuse-beads-ms",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "prepare:assets": "node scripts/prepare-assets.mjs",
        "dev": "npm run prepare:assets && vite --host 127.0.0.1 --port 5173 --strictPort",
        "build": "npm run prepare:assets && tsc --noEmit && vite build",
        "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test Tests/*.test.ts",
        "scenario": "tsx scripts/scenario.ts",
        "selfcheck": "node scripts/browser-selfcheck.mjs",
        "selfcheck:rendering": "node scripts/rendering-selfcheck.mjs",
        "selfcheck:outline": "node scripts/outline-selfcheck.mjs",
        "selfcheck:beads": "node scripts/beads-selfcheck.mjs"
    },
    "dependencies": {
        "three": "0.185.0"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@types/node": "24.10.1",
        "@types/three": "0.185.0",
        "tsx": "4.23.13",
        "typescript": "5.9.3",
        "vite": "7.3.6"
    }
}
